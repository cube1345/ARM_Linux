# 统一文本文件行尾为 LF —— 仓库内恒为 LF，防止 Windows/外部编辑器产生的 CRLF 污染历史。
# * text=auto 让 git add 时自动把 CRLF 归一化回 LF；
# * 各类型再显式强制 eol=lf（checkout 也是 LF）。
* text=auto

# C/C++ 源码
*.c     text eol=lf
*.h     text eol=lf
*.s     text eol=lf
*.S     text eol=lf
*.cpp   text eol=lf
*.cc    text eol=lf
*.cxx   text eol=lf
*.hpp   text eol=lf
*.hh    text eol=lf

# 脚本
*.sh    text eol=lf
*.zsh   text eol=lf
*.py    text eol=lf
*.ps1   text eol=lf
*.bat   text eol=lf
*.pl    text eol=lf

# 构建
Makefile  text eol=lf
Kbuild    text eol=lf
*.cmake   text eol=lf
*.pro     text eol=lf
*.mk      text eol=lf

# 文档 / 数据 / 配置
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.conf  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.dts   text eol=lf
*.dtsi  text eol=lf